# ──────────────────────────────────────────────
# RIVU by WaterTing — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit the actual .env file.
# ──────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rivu
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/rivu

# ── Authentication ────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Providers ──────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional future providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── S3-Compatible Object Storage ──────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rivu-datasets
S3_REGION=us-east-1
S3_USE_SSL=false

# ── Application ───────────────────────────────
APP_NAME=Rivu
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Rivu
NEXT_PUBLIC_APP_ENV=development

# ── Processing ────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
MAX_PROFILE_SAMPLE_ROWS=100000
MAX_AI_SAMPLE_ROWS=1000
JOB_WORKER_CONCURRENCY=4
