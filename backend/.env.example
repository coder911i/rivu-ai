# Rivu backend environment
APP_NAME=Rivu
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_SYNC=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Auth — generate a long random value for production
# OTP testing phone (never commit provider credentials or OTP secrets)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_TEST_PHONE=+919389224210
OTP_ENABLED=false
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# AI
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=groq

# Object storage (local MinIO defaults for development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rivu-datasets
S3_REGION=us-east-1
S3_USE_SSL=false

# Processing
MAX_UPLOAD_SIZE_MB=500
MAX_PROFILE_SAMPLE_ROWS=100000
MAX_AI_SAMPLE_ROWS=1000
JOB_WORKER_CONCURRENCY=4
